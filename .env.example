# Air Crafted Home Environment Variables Example
# Copy this file to .env.local for local development.

# Public site URL (used for canonical links, sitemaps, Open Graph)
NEXT_PUBLIC_SITE_URL=https://aircraftedhome.com

# Analytics & Verification (Leave empty if not configured; scripts will not load without keys)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=

# Contact form workflow endpoint (e.g., Formspree, Resend, or internal API webhook)
CONTACT_FORM_ENDPOINT=

# Affiliate Redirect Security
# Comma-separated list of additional allowed destination hostnames for /go/* redirects
ADDITIONAL_ALLOWED_REDIRECT_HOSTS=
